# PostgreSQL (local install, Neon, Supabase, etc. — Docker not required)
# Format: postgresql://USER:PASSWORD@HOST:5432/contentops?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/contentops?schema=public"

# NextAuth v5 (Auth.js). Production must set AUTH_SECRET and keep it stable across deploys.
# Changing it invalidates all sessions and surfaces JWTSessionError.
# NEXTAUTH_SECRET is still accepted as a fallback if AUTH_SECRET is unset.
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Production example: AUTH_URL / NEXTAUTH_URL="https://pinmaster.site"
# trustHost is enabled in code so the Host header is trusted on pinmaster.site.

# Bootstrap admin (used by seed script)
ADMIN_EMAIL="saboor@xoxodigitals.com"
ADMIN_PASSWORD="PinMaster-ChangeMe-2026!"

# Google Cloud OAuth + Pinterest app credentials are NOT set here.
# Admins enter them in Dashboard → Settings (AppConfig). Unused env names:
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI
# PINTEREST_APP_ID, PINTEREST_APP_SECRET, PINTEREST_REDIRECT_URI

# Optional default model names if a user has not chosen one in Settings.
# AI API keys (OpenRouter, Google AI Studio, SnapGen) are per-user in Settings, not env.
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
OPENROUTER_IMAGE_MODEL="x-ai/grok-2-image"

# Cloudflare R2 (optional if image API returns public URLs)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="contentops"
R2_PUBLIC_URL=""

# Encryption key for stored API keys (32+ chars)
ENCRYPTION_KEY="change-me-to-a-32-char-secret!!"
