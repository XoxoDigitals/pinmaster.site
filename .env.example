R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="contentops"
R2_PUBLIC_URL=""

# Encryption key for stored API keys (32+ chars)
ENCRYPTION_KEY="change-me-to-a-32-char-secret!!"
