# PostgreSQL (local install, Neon, Supabase, etc. — Docker not required)
# Format: postgresql://USER:PASSWORD@HOST:5432/contentops?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/contentops?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Bootstrap admin (used by seed script)
ADMIN_EMAIL="saboor@xoxodigitals.com"
ADMIN_PASSWORD="PinMaster-ChangeMe-2026!"

# Google OAuth (Blogger)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"

# Pinterest OAuth
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_REDIRECT_URI="http://localhost:3000/api/oauth/pinterest/callback"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
OPENROUTER_IMAGE_MODEL="x-ai/grok-2-image"

# Cloudflare R2 (optional if image API returns public URLs)
